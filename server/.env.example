DATABASE_URL="postgresql://bookie:bookie@localhost:5434/bookie?schema=public"
PORT=4142
JWT_SECRET="change-me-in-production-use-long-random-string"
CORS_ORIGIN="http://localhost:4141"
UPLOAD_DIR="./uploads"
NODE_ENV=development

# --- Mail engine -------------------------------------------------------------
# Base URL of the external mail engine. No trailing slash needed; config strips one.
MAIL_API_URL="https://api-mail-engine.mnavasardian.com"
# Sent as the `x-api-key` header. Read only by src/lib/mail.ts, never logged.
# Leave EMPTY in local dev: sends are skipped, the contact form still stores the
# message, and the email-verification link still prints to the API console.
MAIL_API_KEY=""
# Identifies this app to the engine; must match the id registered there.
MAIL_APP_ID="bookie"

# --- Google OAuth ------------------------------------------------------------
# Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client ID,
# type "Web application". GOOGLE_CLIENT_SECRET is read only by
# src/lib/google-oauth.ts and is never logged, returned, or put in an error.
# Leave BOTH empty in local dev: /health reports google:false, the web app hides
# the Google button, and /identity/google redirects back with
# ?error=google_unavailable instead of throwing.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match an Authorized redirect URI on that client character for character —
# scheme, host, port and path. It points at the API (:4142), NOT the web app
# (:4141): the session cookie is host-only on the API origin, so the callback has
# to land here to be able to set it.
#   dev:  http://localhost:4142/identity/google/callback
#   prod: https://api.<domain>/identity/google/callback
GOOGLE_REDIRECT_URI="http://localhost:4142/identity/google/callback"
