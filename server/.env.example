DATABASE_URL="postgresql://bookie:bookie@localhost:5434/bookie?schema=public"
PORT=4142
JWT_SECRET="change-me-in-production-use-long-random-string"
CORS_ORIGIN="http://localhost:4141"
UPLOAD_DIR="./uploads"
NODE_ENV=development

# --- Mail engine -------------------------------------------------------------
# Base URL of the external mail engine. No trailing slash needed; config strips one.
MAIL_API_URL="https://api-mail-engine.mnavasardian.com"
# Sent as the `x-api-key` header. Read only by src/lib/mail.ts, never logged.
# Leave EMPTY in local dev: sends are skipped, the contact form still stores the
# message, and the email-verification link still prints to the API console.
MAIL_API_KEY=""
# Identifies this app to the engine; must match the id registered there.
MAIL_APP_ID="bookie"
