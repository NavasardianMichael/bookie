generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  basic
  standard
  premium
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
  no_show
}

/// How an account was created. **Not an authorisation input** — a `local` account that
/// later links Google authenticates either way. It exists so a password attempt against a
/// passwordless account can be reasoned about, never so a route can branch on trust.
enum AuthProvider {
  local
  google
}

model User {
  id                         String       @id @default(uuid())

  /// The identity. `citext`, so the unique index is case-insensitive **in the database**
  /// rather than only in whichever route remembered to lowercase. Routes here call Prisma
  /// directly with no repository layer, and there are four write paths (register, the
  /// Google callback, change-email confirm, and the seed) — citext is what makes a writer
  /// that forgets harmless instead of the cause of a second account. Writers still
  /// normalise to lowercase so what is stored is canonical.
  email                      String       @unique @db.Citext

  /// Null until the address is confirmed. An unverified account cannot hold a session —
  /// checked in `middleware/auth.ts` on every authenticated request, not only at login, so
  /// one missing guard in a new auth route cannot defeat the rule.
  emailVerifiedAt            DateTime?

  /// argon2id, `m=65536,t=3,p=4` (`lib/password.ts`). Null for a Google-only account,
  /// which has no password to check. `user_credential_present` keeps a row from having
  /// neither this nor `googleId`.
  passwordHash               String?

  /// Google's `sub` claim, never the email — Google emails change, `sub` does not. Unique
  /// so one Google identity cannot be claimed by two accounts.
  googleId                   String?      @unique
  authProvider               AuthProvider @default(local)

  /// Session revocation without Redis. `middleware/auth.ts` compares this against the JWT
  /// claim, which is the only thing that makes a stateless 7-day cookie revocable. Bumped
  /// by password reset, password change, email change, "sign out everywhere", the Google
  /// claim of an unverified account, and account delete. **Not** by ordinary logout —
  /// signing out on a laptop must not sign out a phone.
  tokenVersion               Int          @default(0)

  /// Per-account credential-stuffing brake. Read for free on the login lookup, written
  /// only on a failed attempt. In Postgres rather than `lib/rateLimit.ts` because an
  /// in-memory counter resets on every deploy and is not shared across instances — the two
  /// properties that matter most for exactly this control. A rolling window, not a
  /// lockout: with no admin surface, a permanent lock is a support ticket and a DoS aimed
  /// at the victim rather than the attacker.
  failedLoginCount           Int          @default(0)
  failedLoginWindowStartedAt DateTime?

  /// The address awaiting confirmation. Registration writes the signup address to *both*
  /// `email` and here, so confirm is one unconditional path — copy `pendingEmail` onto
  /// `email`, stamp `emailVerifiedAt`, clear the token — shared by signup verification and
  /// change-email alike. There is no flow discriminator to get wrong.
  pendingEmail               String?      @db.Citext

  /// SHA-256 of the verification link token (32 random bytes), never the token itself.
  /// **Unique, not merely indexed**: the link is clicked with no session, so the row can
  /// only be found by hash — unique turns that into a `findUnique`. 32 random bytes cannot
  /// collide, and Postgres permits any number of NULLs in a unique index.
  emailVerifyTokenHash       String?      @unique
  emailVerifyExpiresAt       DateTime?

  /// Same pattern, same reason, for the password-reset link. One live token per user:
  /// issuing a new one overwrites the old, which is the invalidate-on-reissue a reset flow
  /// wants anyway.
  passwordResetTokenHash     String?      @unique
  passwordResetExpiresAt     DateTime?

  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  consumer                   Consumer?
  provider                   Provider?
}

model Category {
  id            String                 @id @default(uuid())
  name          String                 @unique
  organizations OrganizationCategory[]
  providers     ProviderCategory[]
  services      Service[]
}

model Organization {
  id           String                 @id @default(uuid())
  name         String
  description  String                 @default("")
  phone        String                 @default("")
  country      String                 @default("")
  address      String                 @default("")
  locationUrl  String                 @default("")
  email        String                 @default("")
  website      String                 @default("")
  logoUrl      String                 @default("")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  categories   OrganizationCategory[]
  providers    Provider[]
  appointments Appointment[]
  reviews      Review[]
}

model OrganizationCategory {
  organizationId String
  categoryId     String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([organizationId, categoryId])
}

model Provider {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  description            String?
  imageUrl               String?

  /// Contact phone. Mandatory at registration and **never verified** — it is not identity
  /// any more, so nothing depends on it being reachable.
  ///
  /// On the profile rather than on `User` because the two profiles publish it differently:
  /// `mapProviderDetails` puts a provider's number on the *public* `GET /providers/:id`
  /// payload, while a consumer's reaches only the provider they booked. One shared column
  /// on `User` published the personal number of anyone holding both profiles.
  ///
  /// Deliberately **not** unique. A clinic reception line shared by four providers, or a
  /// household sharing a mobile, is ordinary — the old `@@unique` existed only because
  /// phone *was* the identity. A unique constraint on an unverified field would also
  /// reintroduce an enumeration oracle.
  phoneCode              Int
  phoneNumber            BigInt

  /// A **published** contact address, distinct from the identity `User.email`. Unverified,
  /// non-unique, and writable straight from `PUT /provider-profile` — which is precisely
  /// why it exists: that route used to write the identity email with no verification, so a
  /// provider could set it to a victim's address and then request a password reset.
  /// Setting *this* to someone else's address achieves nothing, because nothing
  /// authenticates against it. Mirrors `Organization.email`.
  publicEmail            String?

  country                String?
  address                String             @default("")
  locationUrl            String             @default("")
  available              Boolean            @default(true)
  /// When false the provider is hidden from Explore and public detail 404s for
  /// everyone except the owner. Independent of `available` (pause bookings).
  /// New accounts start unlisted; they appear only after Publish page.
  listed                 Boolean            @default(false)
  plan                   Plan               @default(free)
  organizationId         String?
  organization           Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  weekSchedule           Json               @default("{}")
  /// Unpublished edits: firstName, lastName, description, imageUrl, weekSchedule,
  /// available, paymentInfo. Publish copies these onto the live columns.
  draft                  Json?
  emailNotificationPrefs Json               @default("{}")
  /// Accepted in-person payment methods, plus optional `{ payToNumber?, notes? }`
  /// that the public profile and booking sheet publish. Saving a new or changed
  /// number is confirmed in a dialog. `{ methods: ('cash'|'card_on_site'|'bank_transfer')[] }`
  paymentInfo            Json?
  /// Owner-authored search metadata. All three are overrides: when null the public
  /// page falls back to the values `generateMetadata` composes from name,
  /// organization and categories, so clearing a field restores the default rather
  /// than blanking the tag. Length-capped and sanitised in `services/providerSeo.ts`.
  seoTitle               String?
  seoDescription         String?
  /// Comma-joined. Emitted as `<meta name="keywords">`, which Google ignores but
  /// other crawlers still scrape — the same reasoning as the derived keywords it
  /// replaces.
  seoKeywords            String?
  /// Vanity URL segment: `/p/<slug>` redirects to the canonical profile URL.
  /// ASCII-only and reserved-word checked (`services/providerSeo.ts`) — a Cyrillic
  /// homograph would let one provider's slug impersonate another's, and an
  /// unreserved slug could shadow a real route segment or a locale code.
  slug                   String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  categories             ProviderCategory[]
  gallery                ProviderGallery[]
  services               Service[]
  appointments           Appointment[]
  reviews                Review[]
  favorites              FavoriteProvider[]

  /// Explore's two hot orderings, both prefixed by `listed` because every public
  /// query filters on it. `newest` and the search paths ride the `listed` prefix and
  /// sort in memory — a third index would cost writes for the least-used control.
  @@index([listed, available, updatedAt])
  @@index([listed, lastName, firstName])
}

model ProviderCategory {
  providerId String
  categoryId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
}

model ProviderGallery {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  url        String
}

model Service {
  id              String        @id @default(uuid())
  providerId      String
  provider        Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  name            String
  durationMinutes Int
  description     String?
  price           Decimal?      @db.Decimal(10, 2)
  currency        String?
  imageUrl        String?
  appointments    Appointment[]
}

model Consumer {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  description            String?

  /// As `Provider.phoneCode`/`phoneNumber`, minus the publication: a consumer's number
  /// reaches only the provider they booked, through `mapProviderBooking`. Mandatory at
  /// registration, never verified, not unique.
  ///
  /// `resolveConsumerId` in `routes/appointments.ts` creates a Consumer on the fly for a
  /// provider who books, and copies these off the Provider row alongside `country` — the
  /// only source it has.
  phoneCode              Int
  phoneNumber            BigInt

  /// ISO 3166-1 alpha-2, captured from the country picked on the phone field at
  /// registration. Nullable because guessing one from the dialling code would be wrong:
  /// +1 is the US, Canada and ~20 more. Mirrors Provider.country, and now sits on the same
  /// row as the phone it was picked beside, so the two can no longer diverge.
  country                String?
  emailNotificationPrefs Json               @default("{}")
  /// Preferred in-person methods only — `{ methods: [...] }`. Card/account numbers
  /// belong on the provider, not here.
  paymentInfo            Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  favorites              FavoriteProvider[]
  appointments           Appointment[]
  reviews                Review[]
}

model FavoriteProvider {
  consumerId String
  providerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([consumerId, providerId])
}

model Appointment {
  id String @id @default(uuid())

  /// Null for a guest booking, where the `guest*` columns carry the booker instead.
  /// Exactly one of the two is always present — enforced by the
  /// `appointment_actor_present` CHECK constraint, which Prisma cannot express.
  /// `onDelete: Restrict` is explicit and load-bearing. Prisma defaults an *optional*
  /// relation to `SetNull`, so making this nullable would otherwise start nulling
  /// consumerId when a Consumer is deleted — quietly turning their appointments into
  /// guest bookings carrying no guest contact details. Deletes stay blocked, which is
  /// what lets `providers.ts` pre-count appointments and answer 409.
  consumerId String?
  consumer   Consumer? @relation(fields: [consumerId], references: [id], onDelete: Restrict)

  /// Contact details for a booking made without an account. Only ever written when
  /// `consumerId` is null; a request carrying a session has its identity read off
  /// the session and these ignored.
  ///
  /// `guestEmail` is required by the `appointment_actor_present` CHECK, not merely
  /// validated in `parseGuest` — accounts are keyed on email now, so it is the only
  /// well-defined handle for recognising a guest who later registers. Nothing reconciles
  /// them today (see the note in `routes/appointments.ts`); the constraint is what would
  /// make it possible.
  guestFirstName   String?
  guestLastName    String?
  guestPhoneCode   Int?
  guestPhoneNumber BigInt?
  guestEmail       String?

  providerId      String
  provider        Provider          @relation(fields: [providerId], references: [id])
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  organizationId  String?
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  /// Price snapshot, copied off the Service at booking time exactly as
  /// `durationMinutes` above is. The column types mirror `Service.price` /
  /// `Service.currency` so there is no unit conversion to get wrong.
  ///
  /// Without it, editing a service's price rewrites the price of every booking
  /// already made against it — an appointment is a record of what was agreed, not
  /// a view onto today's price list. Nullable because the Service's own price is.
  price           Decimal?          @db.Decimal(10, 2)
  currency        String?
  status          AppointmentStatus @default(scheduled)
  notes           String?
  /// How the booker intends to pay, narrowed at write time to what the provider
  /// accepts. Values are `PaymentMethod`; a plain String[] because the codebase
  /// keeps payment methods as JSON strings rather than a DB enum.
  paymentMethods  String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  review          Review?

  @@index([providerId, startAt])
}

model Review {
  id             String       @id @default(uuid())
  consumerId     String
  consumer       Consumer     @relation(fields: [consumerId], references: [id])
  providerId     String?
  provider       Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())
}
