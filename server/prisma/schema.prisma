generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  basic
  standard
  premium
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
  no_show
}

model User {
  id                       String    @id @default(uuid())
  phoneCode                Int
  phoneNumber              BigInt
  otpHash                  String?
  otpExpiresAt             DateTime?
  /// Pending phone change — OTP is stored on the *current* user, never via
  /// `issueOtp` which would upsert a second User row for the new number.
  pendingPhoneCode         Int?
  pendingPhoneNumber       BigInt?
  pendingPhoneOtpHash      String?
  pendingPhoneOtpExpiresAt DateTime?
  pendingEmail             String?
  /// SHA-256 of the email-verification link token (not a 6-digit OTP).
  emailOtpHash             String?
  emailOtpExpiresAt        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  consumer                 Consumer?
  provider                 Provider?

  @@unique([phoneCode, phoneNumber])
}

model Category {
  id            String                 @id @default(uuid())
  name          String                 @unique
  organizations OrganizationCategory[]
  providers     ProviderCategory[]
  services      Service[]
}

model Organization {
  id           String                 @id @default(uuid())
  name         String
  description  String                 @default("")
  phone        String                 @default("")
  country      String                 @default("")
  address      String                 @default("")
  locationUrl  String                 @default("")
  email        String                 @default("")
  website      String                 @default("")
  logoUrl      String                 @default("")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  categories   OrganizationCategory[]
  providers    Provider[]
  appointments Appointment[]
  reviews      Review[]
}

model OrganizationCategory {
  organizationId String
  categoryId     String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([organizationId, categoryId])
}

model Provider {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  description            String?
  imageUrl               String?
  email                  String?
  emailVerifiedAt        DateTime?
  country                String?
  address                String             @default("")
  locationUrl            String             @default("")
  available              Boolean            @default(true)
  /// When false the provider is hidden from Explore and public detail 404s for
  /// everyone except the owner. Independent of `available` (pause bookings).
  listed                 Boolean            @default(true)
  plan                   Plan               @default(free)
  organizationId         String?
  organization           Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  weekSchedule           Json               @default("{}")
  /// Unpublished edits: firstName, lastName, description, imageUrl, weekSchedule,
  /// available, paymentInfo. Publish copies these onto the live columns.
  draft                  Json?
  emailNotificationPrefs Json               @default("{}")
  /// Accepted in-person payment methods — never a card PAN.
  /// `{ methods: ('cash'|'card_on_site'|'bank_transfer'|'other')[], reference?, notes? }`
  paymentInfo            Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  categories             ProviderCategory[]
  gallery                ProviderGallery[]
  services               Service[]
  appointments           Appointment[]
  reviews                Review[]
  favorites              FavoriteProvider[]

  /// Explore's two hot orderings, both prefixed by `listed` because every public
  /// query filters on it. `newest` and the search paths ride the `listed` prefix and
  /// sort in memory — a third index would cost writes for the least-used control.
  @@index([listed, available, updatedAt])
  @@index([listed, lastName, firstName])
}

model ProviderCategory {
  providerId String
  categoryId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
}

model ProviderGallery {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  url        String
}

model Service {
  id              String        @id @default(uuid())
  providerId      String
  provider        Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  name            String
  durationMinutes Int
  description     String?
  price           Decimal?      @db.Decimal(10, 2)
  currency        String?
  imageUrl        String?
  appointments    Appointment[]
}

model Consumer {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  description            String?
  email                  String?
  emailVerifiedAt        DateTime?
  /// ISO 3166-1 alpha-2, captured from the country picked on the phone field at
  /// registration. Nullable because every account created before this column existed
  /// has no answer, and guessing one from the dialling code would be wrong: +1 is the
  /// US, Canada and ~20 more. Mirrors Provider.country.
  country                String?
  emailNotificationPrefs Json               @default("{}")
  /// Accepted in-person payment methods — never a card PAN.
  /// `{ methods: ('cash'|'card_on_site'|'bank_transfer'|'other')[], reference?, notes? }`
  paymentInfo            Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  favorites              FavoriteProvider[]
  appointments           Appointment[]
  reviews                Review[]
}

model FavoriteProvider {
  consumerId String
  providerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([consumerId, providerId])
}

model Appointment {
  id String @id @default(uuid())

  /// Null for a guest booking, where the `guest*` columns carry the booker instead.
  /// Exactly one of the two is always present — enforced by the
  /// `appointment_actor_present` CHECK constraint, which Prisma cannot express.
  /// `onDelete: Restrict` is explicit and load-bearing. Prisma defaults an *optional*
  /// relation to `SetNull`, so making this nullable would otherwise start nulling
  /// consumerId when a Consumer is deleted — quietly turning their appointments into
  /// guest bookings carrying no guest contact details. Deletes stay blocked, which is
  /// what lets `providers.ts` pre-count appointments and answer 409.
  consumerId String?
  consumer   Consumer? @relation(fields: [consumerId], references: [id], onDelete: Restrict)

  /// Contact details for a booking made without an account. Only ever written when
  /// `consumerId` is null; a request carrying a session has its identity read off
  /// the session and these ignored.
  guestFirstName   String?
  guestLastName    String?
  guestPhoneCode   Int?
  guestPhoneNumber BigInt?
  guestEmail       String?

  providerId      String
  provider        Provider          @relation(fields: [providerId], references: [id])
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  organizationId  String?
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  status          AppointmentStatus @default(scheduled)
  notes           String?
  /// How the booker intends to pay, narrowed at write time to what the provider
  /// accepts. Values are `PaymentMethod`; a plain String[] because the codebase
  /// keeps payment methods as JSON strings rather than a DB enum.
  paymentMethods  String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  review          Review?

  @@index([providerId, startAt])
}

model Review {
  id             String       @id @default(uuid())
  consumerId     String
  consumer       Consumer     @relation(fields: [consumerId], references: [id])
  providerId     String?
  provider       Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())
}
