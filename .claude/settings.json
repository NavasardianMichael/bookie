      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.*.local)"
    ]
  }
}
