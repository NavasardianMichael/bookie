{
  "name": "bookie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 4141",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "cd src && npx prettier --write .",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter bookie-server run db:deploy",
    "db:seed": "pnpm --filter bookie-server run db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "server:dev": "pnpm --filter bookie-server dev",
    "watch": "concurrently --kill-others-on-fail -n web,api -c green,cyan \"pnpm dev\" \"pnpm server:dev\"",
    "cleardeps": "rm -rf node_modules",
    "cleardeps:hard": "rm -rf node_modules && rm -rf package-lock.json && rm -rf pnpm-lock.yaml && rm -rf yarn.lock"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@fullcalendar/react": "^7.0.2",
    "antd": "^6.6.1",
    "antd-img-crop": "^4.30.0",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "formik": "^2.4.9",
    "immer": "^11.1.18",
    "libphonenumber-js": "^1.13.11",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-world-flags": "^1.6.0",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/serialize-javascript": "^5.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.6",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix --no-warn-ignored"
    ]
  }
}
