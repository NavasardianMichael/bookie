# Backend origin. Also serves uploaded assets under /uploads.
NEXT_PUBLIC_API_URL=http://localhost:9004

# Public origin of this app — the host that serves the pages. Used for
# metadataBase, per-route canonicals and every JSON-LD `url`/`@id`, so it must be
# the site's own origin and not NEXT_PUBLIC_API_URL. Falls back to the local dev
# origin in src/constants/app.ts when unset, so set it explicitly when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:7004

# Paddle.js, which opens the checkout overlay on /[lang]/billing/checkout. The
# client-side token is public by design (Paddle > Developer Tools > Authentication
# > Client-side tokens). The environment must agree with the API's PADDLE_SANDBOX:
# `sandbox` or `production`. Leave the token empty unless you are working on
# billing — see docs/PADDLE_SETUP.md.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
